<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <StackPanel Spacing="20">
            <Button>Test</Button>
            <Button Classes="IconButton">&#xe65d;</Button>
        </StackPanel>
    </Design.PreviewWith>

    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource TextColor}" />
        <Setter Property="Foreground" Value="#343434" />
        
        <Style Selector="^.IconButton">
            <Setter Property="Background" Value="#343434" />
            <Setter Property="Foreground" Value="{DynamicResource TextColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextColor}" />
            <Setter Property="FontFamily" Value="{DynamicResource Icons}" />
        </Style>
        
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource BackgroundColor}" />
            <Setter Property="Foreground" Value="{DynamicResource TextColor}" />
        </Style>
        
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="White"/>
        </Style>
    </Style>
</Styles>
